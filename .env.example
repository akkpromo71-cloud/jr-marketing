# Скопируйте этот файл в .env.local и заполните значениями из вашего проекта Supabase
# (Project Settings -> API)

NEXT_PUBLIC_SUPABASE_URL=https://xxxxxxxx.supabase.co
NEXT_PUBLIC_SUPABASE_ANON_KEY=your-anon-public-key

# Используется только на сервере (админ-действия). Никогда не используйте в клиентском коде.
SUPABASE_SERVICE_ROLE_KEY=your-service-role-key

# Почтовые уведомления (Resend, https://resend.com). Без них площадка работает,
# просто никто не получает писем.
RESEND_API_KEY=re_xxx
RESEND_FROM=J/R marketing <noreply@ваш-домен>
ADMIN_NOTIFY_EMAIL=admin@ваш-домен
ADMIN_NOTIFY_LOCALE=ru

# Секрет для крон-задач Vercel (/api/cron/*). Без него кроны отвечают 401.
CRON_SECRET=любая-длинная-случайная-строка

# Аналитика Plausible: домен сайта, как он заведён в аккаунте Plausible.
# Без переменной скрипт аналитики на страницу не подключается.
NEXT_PUBLIC_PLAUSIBLE_DOMAIN=jr-marketing-psi.vercel.app
